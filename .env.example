# Copy to .env (git-ignored) next to this file. Used by `so demo` (and `so panel`) for the
# check after each run: is the battery in the box, or should the robot try again?
# Never commit .env, never paste a key into a chat, an issue or the journal.

# ---- Which check decides on a retry -------------------------------------------------------
#   local   our own vision model, trained on our recordings (so vision prepare / train)
#           runs offline on this laptop, no key needed, ~10 ms per photo      (alias: opencv)
#   openai  ChatGPT looks at the overhead photo, needs OPENAI_API_KEY        (alias: chatgpt)
#   claude  Claude looks at the overhead photo, needs ANTHROPIC_API_KEY
#   grip    the gripper position only (cannot see the box)
#   auto    Claude if its key is set, else OpenAI if its key is set, else grip
# `so demo --check <word>` overrides this for one session.
RETRY_CHECK=local

# ---- Keys (only for openai / claude) ------------------------------------------------------
# OpenAI (the name gpt_api_key is accepted too)
OPENAI_API_KEY=
# Claude
ANTHROPIC_API_KEY=

# ---- Optional: other models -----------------------------------------------------------------
# LOCAL_CHECK_MODEL=outputs/vision/model/battery_check.pt
# LOCAL_CHECK_DEVICE=cuda
# OPENAI_CHECK_MODEL=gpt-5.5
# CLAUDE_CHECK_MODEL=claude-opus-5-5
