# Local machine config (ports, camera indices): robot.env for scripts/*.sh,
# hackathon.local.toml for the `so` helper
robot.env
hackathon.local.toml

# Training outputs, checkpoints, camera test frames
outputs/
wandb/

# Machine-specific state discovered by the `so` helper (USB serials, last dataset, benchmarks)
.so101-state.json

