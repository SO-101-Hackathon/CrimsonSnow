docs/offline/
drivers/
media/raw/
# Early layout mock-ups, superseded by docs/strategy/
docs/reject-station-*.png

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Secrets - never commit tokens
.env
*.token
.claude/settings.local.json

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/

# Editable-install metadata
*.egg-info/

