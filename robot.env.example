# Copy to robot.env and edit:  cp robot.env.example robot.env
# Find ports with:   lerobot-find-port      (macOS: /dev/tty.usbmodemXXXX)
# Find cameras with: lerobot-find-cameras opencv

FOLLOWER_PORT=/dev/tty.usbmodemFOLLOWER
LEADER_PORT=/dev/tty.usbmodemLEADER

# Never swap these ids: calibration files are keyed by id.
FOLLOWER_ID=crimson_follower
LEADER_ID=crimson_leader

# OpenCV camera indices
CAM_TOP=1
CAM_WRIST=0
CAM_W=640
CAM_H=480
CAM_FPS=30

# Task / dataset / policy names
# Must stay byte-for-byte identical to [task].description in hackathon.toml (tests/ checks this).
TASK="Put the TNT in the bin"
DATASET_NAME=crimson_dataset
POLICY_NAME=crimson_act
JOB_NAME=act_crimson

# mps on Apple Silicon (macOS 15+), cuda on NVIDIA, cpu otherwise
DEVICE=mps
