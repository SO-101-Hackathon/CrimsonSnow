# Shell scripts must keep Unix line endings or they do not run on Linux, macOS and WSL.
so          text eol=lf
*.sh        text eol=lf
# Windows scripts keep Windows line endings.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
# Everything else: normalised in the repository, native in the working copy.
*.py        text
*.md        text
*.toml      text
*.yml       text
*.csv       text
*.html      text
*.json      text
*.png       binary
*.jpg       binary
